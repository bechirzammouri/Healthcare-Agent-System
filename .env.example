# Environment configuration for the Healthcare Agent

# Neo4j Configuration
NEO4J_URI=bolt+ssc://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=healthcare123

# Authentication Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_DB_PATH=auth.db

# CORS - comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (choose one)
# For Groq (recommended - fast and free)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile

# For OpenAI (alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4

# Agent Configuration
MAX_ITERATIONS=10
TEMPERATURE=0.0
